# Local configuration files that contain personal information
.git-config.nix

# Build outputs and symlinks
result
result-*

# Rust build artifacts
dots/target/

# Generated by matugen at runtime — not tracked in git
configs/hyprland/.config/hypr/colors.conf
configs/kitty/.config/kitty/colors.conf
configs/waybar/.config/waybar/colors.css
configs/dunst/.config/dunst/colors.ini
configs/gtk/.config/gtk-3.0/colors.css
configs/gtk/.config/gtk-4.0/colors.css

# Machine-specific files generated by dots at install time
configs/hyprland/.config/hypr/machine.conf
configs/hyprland/.config/hypr/monitors.conf
configs/waybar/.config/waybar/scripts/brightness-backend.sh

# Rendered from the .conf.in templates by the qt module's post-install hook
# (the @HOME@ expansion) — the .in files are the tracked ones.
configs/qt/.config/qt6ct/qt6ct.conf
configs/qt/.config/qt5ct/qt5ct.conf
configs/qt/.config/qt6ct/colors/
configs/qt/.config/qt5ct/colors/

# Temporary files
*.tmp
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db