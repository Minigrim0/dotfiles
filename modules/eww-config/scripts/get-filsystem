#!/bin/bash
# Get filesystem info for both / and /home
root_info=$(df -h / 2>/dev/null | awk 'NR==2 {printf "/ %s/%s", $3, $2}')
home_info=$(df -h /home 2>/dev/null | awk 'NR==2 {printf "/home %s/%s", $3, $2}')

# Check if /home is a separate mount point
if [ "$home_info" != "" ] && ! mountpoint -q /home; then
    # /home is not a separate mount point, just show root
    echo "$root_info"
else
    # /home is separate, show both
    if [ "$home_info" != "" ]; then
        echo "$root_info | $home_info"
    else
        echo "$root_info"
    fi
fi
