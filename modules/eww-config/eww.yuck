;; Variables
(defvar power-menu-open false)
(defvar system-menu-open false)
(defvar brightness-menu-open false)
(defvar volume-menu-open false)

;; Polling variables - with fallbacks
(defpoll volume :interval "1s" :initial "50" "scripts/get-volume")
(defpoll brightness :interval "2s" :initial "50" "scripts/get-brightness")
(defpoll wifi :interval "3s" :initial "WiFi" "scripts/get-wifi")
(defpoll battery :interval "5s" :initial "Battery" "scripts/get-battery")
(defpoll cpu-temp :interval "3s" :initial "45" "scripts/get-temp")
(defpoll filesystem :interval "10s" :initial "/ -" "scripts/get-filesystem")
(defpoll time :interval "1s" :initial "12:00" "date '+%H:%M'")
(defpoll date :interval "30s" :initial "01/01" "date '+%m/%d'")

;; Listen to hyprland workspaces - with fallback
(deflisten workspaces :initial '[{"id": 1}]' "scripts/get-workspaces")
(deflisten current-workspace :initial "1" "scripts/get-active-workspace")

;; Wofi launcher button
(defwidget launcher []
  (button :class "launcher-btn"
          :onclick "wofi --show drun &"
          :tooltip "Applications"
    "󱗼"))

;; Workspace widget
(defwidget workspaces []
  (box :class "workspaces"
       :orientation "h"
       :space-evenly false
       :spacing 4  ; Add spacing between workspace buttons
    (for workspace in workspaces
      (button :class "${workspace.id == current-workspace ? "workspace-active" : "workspace-inactive"}"
              :onclick "hyprctl dispatch workspace ${workspace.id} &"
              :tooltip "Workspace ${workspace.id}"
        "${workspace.id}"))))

;; System menu
(include "./widgets/system-menu.yuck")

;; Brightness button and menu
(include "./widgets/brightness.yuck")

;; Volume button and menu
(include "./widgets/volume.yuck")

;;Power menu
(include "./widgets/power-menu.yuck")

;; Main bar - horizontal layout with proper alignment
(defwidget bar []
  (box :orientation "h" :class "bar-container" :space-evenly false
    ;; Left section - launcher and workspaces
    (box :orientation "h" :space-evenly false :halign "start" :spacing 8
      (launcher)
      (workspaces))

    ;; Center spacer - expands to push right elements to the right
    (box :hexpand true)

    ;; Right section - system controls and datetime
    (box :orientation "h" :space-evenly false :halign "end" :spacing 4
      ;; System menu (conditional display)
      (system-menu-button)
      (system-menu)
      
      ;; Brightness menu (conditional display) 
      (brightness-button)
      (brightness-menu)
      
      ;; Volume menu (conditional display)
      (volume-button)
      (volume-menu)  
      
      ;; System tray
      (systray :orientation "h" :icon-size 15)

      ;; DateTime - always visible
      (box :class "datetime" :orientation "h" :space-evenly false :spacing 4
        (label :class "time-display" :text "${time}")
        (label :class "date-display" :text "${date}"))
            
      ;; Power button - always visible  
      (power-button)
      
      ;; Power menu (conditional display)
      (power-menu))))

;; Main window - horizontal top bar
(defwindow main-bar
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0"
                      :y "0"
                      :width "100%"
                      :height "32px"  ; Fixed height instead of percentage
                      :anchor "top center")
  :exclusive true
  :stacking "fg"  ; Keep bar on top
  (bar))