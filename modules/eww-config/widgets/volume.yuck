;; Volume menu
(defwidget volume-menu []
  (eventbox
    :onhover "eww update volume-menu-open=1"
    :onhoverlost "eww update volume-menu-open=0"
    (stack
      :selected volume-menu-open
      :transition "slideleft"
      :samesize false
      (button :class "volume-btn"
        :tooltip "Volume: ${volume}"
        "")
      (box :class "volume-menu" :orientation "h" :space-evenly false
        (label :text {volume == "Muted" ? "Muted" : "${volume}%"})
        (scale :class "volume-slider"
          :value {volume == "Muted" ? 0 : volume}
          :min 0
          :max 100
          :orientation "h"
          :flipped false
          :onchange "pactl set-sink-volume 0 $(printf %.0f {})%")))))
