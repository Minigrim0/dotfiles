# Generated by matugen — do not edit by hand.
# Source: ~/.config/matugen/templates/plymouth.script
#
# A `script`-module plymouth theme: the logo centered at its native size on
# black, with a pill entry field below it for the LUKS passphrase.
#
# The ground is black rather than the palette surface on purpose. The logo's
# outer ring is a dead-flat near-black field, so black is what makes the
# 512x512 square edgeless with no feathering at all — feathering it into a
# lighter surface tone instead leaves a dark halo, because the artwork's black
# is darker than any surface color matugen produces. The palette still drives
# the entry, the bullets and every piece of text.
#
# Nothing here scales with resolution — the logo is composited 1:1 by request,
# and the entry is sized to sit with it rather than with the screen.
#
# The initramfs holds a *copy* of this file. Re-rendering it changes nothing at
# boot until `dots splash apply` reinstalls the theme and runs mkinitcpio.

#----------------------------------------- Palette --------------------------------

muted.r        = {{colors.on_surface_variant.default.red}}   / 255;
muted.g        = {{colors.on_surface_variant.default.green}} / 255;
muted.b        = {{colors.on_surface_variant.default.blue}}  / 255;

error.r        = {{colors.error.default.red}}                / 255;
error.g        = {{colors.error.default.green}}              / 255;
error.b        = {{colors.error.default.blue}}               / 255;

font_small = "Adwaita Sans 12";

#----------------------------------------- Ground & logo --------------------------------

# One layout, on head 0's geometry — NOT one per head.
#
# Plymouth's DRM renderer builds an independent head per distinct mode and does
# not lay them out on a shared desktop: every head sits at origin (0,0) and
# mirrors the same sprite canvas. So placing a group per head does not put one
# group on each screen, it puts *all* the groups on *every* screen. That was
# tried here and the result was two password fields on both monitors, 320px
# apart. Window.GetX(i)/GetWidth(i) exist, but on this renderer they describe
# mirrored views of one canvas rather than tiles of a desktop.
#
# Consequence for a mixed-resolution setup (2560x1440 + 1920x1080 here):
# centering on head 0 puts the group 320px right of centre on the smaller
# screen. Everything still fits — the lowest element lands at y=1043, clearing
# 1080 by 37px — so this is an alignment compromise, not a clipped one.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

# Composited 1:1 — no Scale() call anywhere on this sprite.
logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen.w / 2 - logo.image.GetWidth()  / 2;
# 0.42 rather than 0.5: the entry sits below, and centering the pair reads
# better than centering the logo and hanging the entry off the bottom.
logo.y = screen.h * 0.42 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 1);

#----------------------------------------- Passphrase --------------------------------

layout.entry_y = logo.y + logo.image.GetHeight() + 64;

status = "normal";

fun dialog_setup()
  {
    local.entry;
    local.label;

    entry.image  = Image("entry.png");
    entry.sprite = Sprite(entry.image);
    entry.x = screen.w / 2 - entry.image.GetWidth() / 2;
    entry.y = layout.entry_y;
    entry.z = 100;
    entry.sprite.SetPosition(entry.x, entry.y, entry.z);

    label.image  = Image.Text("Enter passphrase", muted.r, muted.g, muted.b, 1, font_small);
    label.sprite = Sprite(label.image);
    label.sprite.SetPosition(screen.w / 2 - label.image.GetWidth() / 2,
                             entry.y + entry.image.GetHeight() + 16,
                             entry.z);

    global.dialog.entry = entry;
    global.dialog.label = label;
    global.dialog.bullet_image = Image("bullet.png");

    # Caps lock and failure notices share one slot below the label — they are
    # never both relevant, and stacking them would shift the layout mid-typing.
    global.dialog.notice = Sprite();
    global.dialog.notice.SetPosition(0, 0, entry.z);
    global.dialog.notice_shown = 0;

    dialog_opacity(1);
  }

fun dialog_opacity(opacity)
  {
    dialog.entry.sprite.SetOpacity(opacity);
    dialog.label.sprite.SetOpacity(opacity);
    dialog.notice.SetOpacity(opacity);
    for (index = 0; dialog.bullet[index]; index++)
      {
        dialog.bullet[index].sprite.SetOpacity(opacity);
      }
  }

fun set_notice(text, r, g, b)
  {
    local.image = Image.Text(text, r, g, b, 1, font_small);
    dialog.notice.SetImage(image);
    dialog.notice.SetPosition(screen.w / 2 - image.GetWidth() / 2,
                              dialog.entry.y + dialog.entry.image.GetHeight() + 46,
                              dialog.entry.z);
    dialog.notice.SetOpacity(1);
    global.dialog.notice_shown = 1;
  }

fun clear_notice()
  {
    if (dialog.notice_shown)
      {
        dialog.notice.SetOpacity(0);
        global.dialog.notice_shown = 0;
      }
  }

fun display_normal_callback()
  {
    global.status = "normal";
    if (global.dialog)
      dialog_opacity(0);
  }

# The prompt the encrypt hook passes is "A password is required to access the
# root volume", which is both long and redundant next to an entry field. It is
# deliberately ignored in favour of the fixed label above.
fun display_password_callback(prompt, bullets)
  {
    global.status = "password";
    if (!global.dialog)
      dialog_setup();
    else
      dialog_opacity(1);

    # Bullets are laid out from the centre so the string grows both ways
    # instead of drifting right off a left-aligned origin.
    local.gap = dialog.bullet_image.GetWidth() + 8;
    local.row_w = bullets * gap - 8;
    local.start_x = screen.w / 2 - row_w / 2;
    local.mid_y = dialog.entry.y + dialog.entry.image.GetHeight() / 2
                  - dialog.bullet_image.GetHeight() / 2;

    for (index = 0; dialog.bullet[index] || index < bullets; index++)
      {
        if (!dialog.bullet[index])
          {
            dialog.bullet[index].sprite = Sprite(dialog.bullet_image);
          }
        dialog.bullet[index].sprite.SetPosition(start_x + index * gap, mid_y,
                                                dialog.entry.z + 1);
        if (index < bullets)
          dialog.bullet[index].sprite.SetOpacity(1);
        else
          dialog.bullet[index].sprite.SetOpacity(0);
      }

    if (Plymouth.GetCapslockState())
      set_notice("Caps Lock is on", error.r, error.g, error.b);
    else
      clear_notice();
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

#----------------------------------------- Messages --------------------------------

# Boot messages (fsck progress, service failures) go bottom-centre in the muted
# color rather than plymouth's default top-left white, which would land on the
# logo.
message.sprite = Sprite();

fun display_message_callback(text)
  {
    local.image = Image.Text(text, muted.r, muted.g, muted.b, 1, font_small);
    message.sprite.SetImage(image);
    message.sprite.SetPosition(screen.w / 2 - image.GetWidth() / 2,
                               screen.h - image.GetHeight() - 48, 10000);
  }

fun hide_message_callback(text)
  {
    global.message.sprite = Sprite();
  }

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
