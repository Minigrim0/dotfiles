# Session environment, read by uwsm before the compositor starts.
#
# This is the single place session variables live. hyprland.conf used to carry
# an `env =` block, but those only reach the compositor's own children — not
# systemd user units, not anything D-Bus activates. uwsm exports these into the
# systemd user manager and the D-Bus activation environment, which is the whole
# reason to run the session under it.
#
# The corollary: these are lost if you log into the plain "Hyprland" session
# instead of "Hyprland (uwsm-managed)". `dots doctor` reports which one you got.

# --- Toolkit theming -------------------------------------------------------
# Qt6 apps read this and load configs/qt/.config/qt6ct. Qt5 apps look for a
# plugin key of their own ("qt5ct") and ignore the value, so the qt module's
# hook overrides VLC's desktop entry instead of trying to satisfy both here.
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

# --- Cursor ----------------------------------------------------------------
# Also set as hyprcursor, which Hyprland prefers when the theme provides it.
export XCURSOR_THEME=Bibata-Modern-Classic
export XCURSOR_SIZE=24
export HYPRCURSOR_THEME=Bibata-Modern-Classic
export HYPRCURSOR_SIZE=24

# --- Wayland-native by default ---------------------------------------------
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export _JAVA_AWT_WM_NONREPARENTING=1

# --- Session identity ------------------------------------------------------
# xdg-desktop-portal picks its backend from this; it is what routes screencast
# to xdg-desktop-portal-hyprland and file dialogs to the GTK one.
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
