[global]
    monitor              = 0
    follow               = mouse
    width                = 380
    height               = (0, 300)
    origin               = top-right
    offset               = (14, 52)
    gap_size             = 8
    notification_limit   = 0

    progress_bar               = true
    progress_bar_height        = 8
    progress_bar_frame_width   = 0
    progress_bar_corner_radius = 4
    progress_bar_min_width     = 150
    progress_bar_max_width     = 330

    indicate_hidden      = yes
    separator_height     = 2
    padding              = 14
    horizontal_padding   = 16
    text_icon_padding    = 12
    frame_width          = 2
    frame_color          = "#645156"
    separator_color      = frame
    corner_radius        = 12

    font                 = AnonymicePro Nerd Font 11
    markup               = full
    format               = "<b>%s</b>\n%b"
    alignment            = left
    vertical_alignment   = center
    show_age_threshold   = 60
    ellipsize            = middle
    ignore_newline       = no
    stack_duplicates     = true
    hide_duplicate_count = false
    show_indicators      = yes

    icon_position        = left
    min_icon_size        = 0
    max_icon_size        = 48

    sticky_history       = yes
    history_length       = 20

    dmenu                = wofi -p dunst:
    browser              = firefox

    always_run_script    = true
    title                = Dunst
    class                = Dunst

    mouse_left_click     = close_current
    mouse_middle_click   = do_action, close_current
    mouse_right_click    = close_all

[experimental]
    per_monitor_dpi = false

# Colors generated by matugen (overrides fallbacks below when a wallpaper is set)
include = ~/.config/dunst/colors.ini

[urgency_low]
    background = "#1F242D"
    foreground = "#ffffff"
    timeout    = 10

[urgency_normal]
    background = "#1F242D"
    foreground = "#ffffff"
    timeout    = 10

[urgency_critical]
    background  = "#DF502C"
    foreground  = "#ffffff"
    frame_color = "#C74D39"
    timeout     = 0
